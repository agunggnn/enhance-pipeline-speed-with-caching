concurrent = 4
check_interval = 0
shutdown_timeout = 0

[session_server]
  session_timeout = 1800

[[runners]]
  name = "macbook-podman-flutter-runner"
  url = "http://${PC_LAN_IP}:8080"
  token = "${GITLAB_RUNNER_TOKEN}"
  executor = "docker"

  [runners.docker]
    # Podman Machine exposes a Docker-compatible socket. DOCKER_HOST must use the
    # unix:// prefix; GitLab Runner passes this directly to the Docker client library.
    host = "unix://${PODMAN_SOCKET_PATH}"
    image = "ubuntu:22.04"
    privileged = false
    volumes = ["/cache"]
    pull_policy = ["if-not-present"]

  [runners.cache]
    Type = "s3"
    Shared = true
    [runners.cache.s3]
      # PC LAN IP — runner is outside gitlab-net, container DNS does not apply.
      ServerAddress = "${PC_LAN_IP}:9000"
      AccessKey = "${MINIO_ROOT_USER}"
      SecretKey = "${MINIO_ROOT_PASSWORD}"
      BucketName = "${GITLAB_CACHE_BUCKET}"
      Insecure = true
      Region = "us-east-1"

  [runners.feature_flags]
    FF_USE_FASTZIP = true
