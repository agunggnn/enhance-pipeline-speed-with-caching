# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Windows PC LAN IP (where GitLab and MinIO now run, via WSL2)
# Find it on Windows: ipconfig | findstr "IPv4"
PC_LAN_IP=192.168.1.24

# MinIO credentials — CHANGE THESE before first run. Must match the values used
# when the MinIO container was started (server-pc/setup-wsl2-server.sh reads them).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# Cache bucket name
GITLAB_CACHE_BUCKET=gitlab-cache

# GitLab Runner registration token
# Get from: GitLab UI → Admin → CI/CD → Runners → New instance runner
GITLAB_RUNNER_TOKEN=

# GitLab API access (for benchmark.sh)
# Get from: GitLab UI → User avatar → Preferences → Access Tokens (scope: api)
GITLAB_API_TOKEN=

# GitLab project ID for the Flutter demo project
# Find in: project → Settings → General
GITLAB_PROJECT_ID=

# Flutter version to build and cache
FLUTTER_VERSION=3.19.6

# Full filesystem path to the Podman Machine socket (without unix:// prefix).
# Auto-detected by setup-macos.sh and written to ~/.gitlab-runner-podman.env.
# Override here only if auto-detection fails.
# Find manually: podman machine inspect gitlab-runner-vm --format '{{.ConnectionInfo.PodmanSocket.Path}}'
PODMAN_SOCKET_PATH=
