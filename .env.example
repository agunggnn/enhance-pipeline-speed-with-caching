# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# MacBook LAN IP (where GitLab and MinIO are running)
# Find it on macOS: ipconfig getifaddr en0
MACBOOK_LAN_IP=192.168.1.x

# MinIO credentials (must match what was set when starting the MinIO container)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Cache bucket name (created in MinIO console)
GITLAB_CACHE_BUCKET=gitlab-cache

# GitLab Runner registration token
# Get from: GitLab UI → Admin → CI/CD → Runners → New instance runner
GITLAB_RUNNER_TOKEN=

# GitLab API access (for benchmark script)
# Get from: GitLab UI → User avatar → Preferences → Access Tokens (scope: api)
GITLAB_API_TOKEN=

# GitLab project ID for the Flutter demo project
# Find in: project → Settings → General (shows as "Project ID")
GITLAB_PROJECT_ID=

# Flutter version to install and cache
FLUTTER_VERSION=3.19.6
